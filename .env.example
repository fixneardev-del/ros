# Hosted Supabase project eohqgkxnjshnzwadglnh.
# The previous local stack config is in .env.local.local-stack.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://eohqgkxnjshnzwadglnh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_p6H_XvCk12XQ8kSmY2rBzQ_4KQWVGFw
# Server-only key for admin actions and the notification outbox.
# Paste the hosted secret key (sb_secret_...) here.
SUPABASE_SECRET_KEY=

# A real Resend key and a verified sending domain are both required for email.
# Placeholder values deliberately disable sending; outbox rows stay failed so
# they can be retried after the real values are added.
RESEND_API_KEY=
EMAIL_FROM="Repairs and Other Services <hello@your-verified-domain.co.uk>"
EMAIL_REPLY_TO=
ADMIN_NOTIFICATION_EMAIL=admin@your-verified-domain.co.uk

# Optional signer for the short-lived password-recovery cookie.
# Defaults to SUPABASE_SECRET_KEY when omitted.
RESET_SESSION_SECRET=

# Required for the daily Vercel cron call to /api/notifications/retry.
# Vercel sends it as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
